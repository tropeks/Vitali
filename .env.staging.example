# Vitali — Staging Environment Variables
# Copy to .env.staging and fill in all required values before first deploy.
# See docs/DEPLOY.md for full reference including where to get each value.

# ─── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-python-secrets
ENVIRONMENT=staging
DEBUG=False
ALLOWED_HOSTS=staging.vitali.com.br,localhost
CSRF_TRUSTED_ORIGINS=https://staging.vitali.com.br
# docker-compose.staging.yml now hardcodes ENFORCE_TENANT_MEMBERSHIP=true on the
# django/celery-worker/celery-beat services (core.E002 blocks `check --deploy`
# otherwise), so this value is effectively informational — but it must still be
# True here: some tooling (e.g. local `manage.py` runs against this env file)
# reads it directly. Before the FIRST deploy that turns this on, run, in order:
#   1. python manage.py backfill_tenant_memberships --dry-run --report
#   2. python manage.py grant_tenant_membership <email> <schema> for every
#      reported orphan (active user with no data footprint in any tenant)
#   3. python manage.py backfill_tenant_memberships   (writes memberships)
#   4. python manage.py backfill_tenant_memberships --dry-run --fail-on-orphans
#      (verification: must exit 0)
# Skipping this: any active user without a materialized UserTenantMembership
# gets a 401 on their next request once enforcement flips on.
ENFORCE_TENANT_MEMBERSHIP=True

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=vitali
POSTGRES_USER=vitali
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://vitali:change-me-strong-password@postgres:5432/vitali

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ─── GHCR Image Registry ──────────────────────────────────────────────────────
GHCR_REPO=tropeks
IMAGE_TAG=latest

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-base64-fernet-key

# ─── Backups ──────────────────────────────────────────────────────────────────
# REQUIRED (scripts/backup.sh and vitali/settings/production.py both fail hard
# without it): pg_dump backups contain LGPD-regulated clinical data (EMR) and
# must always be encrypted at rest. Generate with scripts/gen_secrets.sh and
# store in an offline vault — losing it makes every encrypted dump
# unrecoverable, guard it like FIELD_ENCRYPTION_KEY. To explicitly disable
# encryption for a throwaway environment with no real patient data instead,
# set BACKUP_ALLOW_PLAINTEXT=1 (never do this against a deployment with real
# clinical data). NOTE: docker-compose.staging.yml's db-backup service does
# not currently forward this variable into its container — it must be added
# to that service's `environment:` block (and its `printenv` snapshot pattern)
# before this key takes effect there; see docs/BACKUPS.md.
BACKUP_ENCRYPTION_KEY=change-me-generate-with-scripts-gen-secrets-sh
# BACKUP_ALLOW_PLAINTEXT=1

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@vitali.com.br

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://staging.vitali.com.br

# Internal Basic header injected by nginx only after Vitali authorization.
# Generate from a dedicated archive account; never expose it to the browser.
ORTHANC_AUTH_HEADER=Basic Y2hhbmdlLW1lOmNoYW5nZS1tZQ==
ORTHANC_USERNAME=change-me
ORTHANC_PASSWORD=change-me
ORTHANC_WEBHOOK_SECRET=change-me-strong-webhook-secret
# Production only: bind C-STORE to a trusted LAN IP when modalities push directly.
# ORTHANC_DICOM_BIND_ADDRESS=192.0.2.10

# ─── Optional PostgreSQL PITR overlay ────────────────────────────────────────
PITR_ARCHIVE_TIMEOUT=300s
PITR_MAX_WAL_AGE_SECONDS=600
PITR_S3_SSE=AES256
# Host-only paths; do not put backup contents in the repository.
PITR_BASEBACKUP_DIR=/var/backups/vitali/pitr/base
PITR_BASEBACKUP_KEEP_LAST=5

# ─── Optional observability overlay ──────────────────────────────────────────
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=20GB
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=vitali-admin
GRAFANA_COOKIE_SECURE=false
POSTGRES_EXPORTER_PASSWORD_FILE=/etc/vitali/postgres-exporter-password
REDIS_EXPORTER_PASSWORD_FILE=/etc/vitali/redis-exporter-passwords.json
GRAFANA_ADMIN_PASSWORD_FILE=/etc/vitali/grafana-admin-password

# ─── AI / Claude ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
FEATURE_AI_TUSS=True

# ─── WhatsApp / Evolution API ────────────────────────────────────────────────
WHATSAPP_EVOLUTION_URL=http://evolution-api:8080
WHATSAPP_EVOLUTION_API_KEY=change-me-evolution-api-key
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
