{# Guia de Consulta — TISS 4.01.00 (ctm_consultaGuia, tissGuiasV4_01_00.xsd).
   Rewritten against the real XSD (was emitting <dadosConsulta>/<nomeBeneficiario>,
   neither of which exists in 4.01.00 — see billing 2.4 audit).
   xml_engine.generate_guide_xml() guarantees exactly one `item` is passed in:
   ctm_consultaGuia models a single <procedimento>, not a repeatable list. #}
<ans:guiaConsulta>
  <ans:cabecalhoConsulta>
    <ans:registroANS>{{ guide.provider.ans_code }}</ans:registroANS>
    <ans:numeroGuiaPrestador>{{ guide.guide_number }}</ans:numeroGuiaPrestador>
  </ans:cabecalhoConsulta>
  <ans:dadosBeneficiario>
    <ans:numeroCarteira>{{ guide.insured_card_number }}</ans:numeroCarteira>
    {# atendimentoRN (recém-nascido): não há dado de origem no model — "N" é o
       default seguro (a grande maioria dos atendimentos não é de RN). #}
    <ans:atendimentoRN>N</ans:atendimentoRN>
  </ans:dadosBeneficiario>
  <ans:contratadoExecutante>
    {# codigoPrestadorNaOperadora: mesmo placeholder do cabeçalho do lote —
       ver comentário em batch_envelope.xml.j2. #}
    <ans:codigoPrestadorNaOperadora>{{ professional.cnes_code if professional else '' }}</ans:codigoPrestadorNaOperadora>
    <ans:CNES>{{ professional.cnes_code if professional else '' }}</ans:CNES>
  </ans:contratadoExecutante>
  <ans:profissionalExecutante>
    <ans:conselhoProfissional>{{ professional.council_type | conselho_ans_code if professional else '' }}</ans:conselhoProfissional>
    <ans:numeroConselhoProfissional>{{ professional.council_number if professional else '' }}</ans:numeroConselhoProfissional>
    <ans:UF>{{ professional.council_state | uf_ibge_code if professional else '' }}</ans:UF>
    <ans:CBOS>{{ professional.cbo_code if professional else '225120' }}</ans:CBOS>
  </ans:profissionalExecutante>
  {# indicacaoAcidente (dm_indicadorAcidente): sem dado de origem no model —
     "9" (Não acidente) é o default TISS-padrão, igual ao já usado no
     <indicadorAcidente> do diagnóstico antes desta correção. #}
  <ans:indicacaoAcidente>9</ans:indicacaoAcidente>
  <ans:dadosAtendimento>
    {# regimeAtendimento (dm_regimeAtendimento): "01" = Ambulatorial — é o
       único regime plausível para uma guia de consulta (o model não
       distingue regimes). #}
    <ans:regimeAtendimento>01</ans:regimeAtendimento>
    <ans:dataAtendimento>{{ guide.encounter.encounter_date | format_date }}</ans:dataAtendimento>
    {# tipoConsulta (dm_tipoConsulta): "1" = Primeira — o model não distingue
       primeira consulta de retorno; default fixo, flagged como limitação. #}
    <ans:tipoConsulta>1</ans:tipoConsulta>
    <ans:procedimento>
      <ans:codigoTabela>22</ans:codigoTabela>
      <ans:codigoProcedimento>{{ item.tuss_code.code }}</ans:codigoProcedimento>
      <ans:valorProcedimento>{{ item.total_value | format_currency }}</ans:valorProcedimento>
    </ans:procedimento>
  </ans:dadosAtendimento>
</ans:guiaConsulta>
