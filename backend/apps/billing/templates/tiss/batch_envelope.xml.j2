<?xml version="1.0" encoding="UTF-8"?>
{# TISS 4.01.00 batch envelope — mensagemTISS #}
<ans:mensagemTISS
  xmlns:ans="http://www.ans.gov.br/padroes/tiss/schemas"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.ans.gov.br/padroes/tiss/schemas tissV4_01_00.xsd">

  <ans:cabecalho>
    <ans:identificacaoTransacao>
      <ans:tipoTransacao>ENVIO_LOTE_GUIAS</ans:tipoTransacao>
      <ans:sequencialTransacao>{{ batch.batch_number }}</ans:sequencialTransacao>
      <ans:dataRegistroTransacao>{{ now | format_date }}</ans:dataRegistroTransacao>
      <ans:horaRegistroTransacao>{{ now | format_time }}</ans:horaRegistroTransacao>
    </ans:identificacaoTransacao>
    <ans:origem>
      <ans:identificacaoPrestador>
        {# ct_prestadorIdentificacao (tissComplexTypesV4_01_00.xsd) accepts
           CNPJ | CPF | codigoPrestadorNaOperadora — NOT CNES. No model in
           scope carries the clinic's CNPJ or a payer-assigned provider code
           (apps.core.Tenant.cnpj lives in the public schema, out of reach of
           this per-tenant service; InsuranceProvider.cnpj is the payer's own
           CNPJ, not ours). Reusing the CNES text here is a schema-valid
           placeholder (codigoPrestadorNaOperadora is free text, <=14 chars)
           but NOT the real payer-assigned code — flagged as a known gap. #}
        <ans:codigoPrestadorNaOperadora>{{ clinic_cnes }}</ans:codigoPrestadorNaOperadora>
      </ans:identificacaoPrestador>
    </ans:origem>
    <ans:destino>
      <ans:registroANS>{{ batch.provider.ans_code }}</ans:registroANS>
    </ans:destino>
    <ans:Padrao>4.01.00</ans:Padrao>
  </ans:cabecalho>

  <ans:prestadorParaOperadora>
    <ans:loteGuias>
      <ans:numeroLote>{{ batch.batch_number }}</ans:numeroLote>
      <ans:guiasTISS>
{% for guide in guides %}
{{ guide_xml[guide.guide_number] }}
{% endfor %}
      </ans:guiasTISS>
    </ans:loteGuias>
  </ans:prestadorParaOperadora>

  <ans:epilogo>
    <ans:hash>{{ xml_hash }}</ans:hash>
  </ans:epilogo>

</ans:mensagemTISS>
